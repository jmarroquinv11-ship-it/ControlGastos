<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#061916">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar ingreso"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="26sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Agrega tu salario, comisión, bono u otro ingreso."
            android:textColor="#9FE8BD"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/etConceptoIngreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="Concepto (ej. Salario de octubre)"
            android:textColor="#FFFFFF"
            android:textColorHint="#B8C7C2"
            android:inputType="textCapSentences" />
        <EditText
            android:id="@+id/etMontoIngreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Monto en quetzales (Q)"
            android:textColor="#FFFFFF"
            android:textColorHint="#B8C7C2"
            android:inputType="numberDecimal" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tipo de ingreso"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
        <Spinner
            android:id="@+id/spTipoIngreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FFFFFF" />
        <Button
            android:id="@+id/btnGuardarIngreso"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:text="Guardar ingreso"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#08A66D" />
    </LinearLayout>
</ScrollView>
